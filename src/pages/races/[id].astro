---
/**
 * ONE template for every race (Senate and House). Nothing here is
 * specific to a candidate or party. Same sections, same order, for everyone.
 */
import Layout from '../../layouts/Layout.astro';
import RatingScale from '../../components/RatingScale.astro';
import PollCard from '../../components/PollCard.astro';
import MoneyBars from '../../components/MoneyBars.astro';
import PastResults from '../../components/PastResults.astro';
import PartyTag from '../../components/PartyTag.astro';
import Term from '../../components/Term.astro';
import Source from '../../components/Source.astro';
import SourceList from '../../components/SourceList.astro';
import Limits from '../../components/Limits.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import AverageBuilder from '../../islands/AverageBuilder';
import Scoreboard from '../../components/Scoreboard.astro';
import Icon from '../../components/Icon.astro';
import { summarize } from '../../lib/summary';
import { db, candidatesInRace, ratingsForRace, pollsForRace, pastResultsForRace, resultsForPoll, partyById, sourceById, majorPair, pendingRecentPolls, lastChecked } from '../../lib/data';
import { pollingAverage, missForState, type AvgPoll } from '../../lib/average';
import { stateName } from '../../lib/states';
import { ratingsHeadline } from '../../lib/ratings';
import { confidence, daysBetween, pollDate, RECENT_DAYS } from '../../lib/polls';
import { date, dateShort, plural } from '../../lib/format';

export function getStaticPaths() {
  return db.races.map((race) => ({ params: { id: race.id }, props: { race } }));
}

const { race } = Astro.props;
const summary = summarize(race);
const today = new Date();
const candidates = candidatesInRace(race.id);
const ratings = ratingsForRace(race.id);
const polls = pollsForRace(race.id);
const recent = polls.filter((p) => daysBetween(pollDate(p), today) <= RECENT_DAYS);
const conf = confidence(polls, today);
const past = pastResultsForRace(race.id);
const office = race.chamber === 'senate' ? 'U.S. Senate' : 'U.S. House';
const allRatingsHidden = ratings.length === 0 && db.ratings.some((r) => r.race === race.id);

// ---- polling average (same code runs in the browser for the toggles) ----
const todayIso = today.toISOString().slice(0, 10);
const candIds = new Set(candidates.map((c) => c.id));
const avgPolls: AvgPoll[] = polls.map((p) => ({
  id: p.id,
  pollster: p.pollster,
  sponsorType: p.sponsor_type,
  sponsorLean: p.sponsor_lean,
  population: p.population,
  sampleSize: p.sample_size,
  date: pollDate(p),
  shares: Object.fromEntries(resultsForPoll(p.id).filter((r) => candIds.has(r.candidate)).map((r) => [r.candidate, r.pct])),
}));
const onHold = pendingRecentPolls(race.id, today);
const baseAvg = onHold.length ? null : pollingAverage(avgPolls, { today: todayIso });
const pair = majorPair(race.id);
const history = db.pollHistory;
const misses = history.cycles.map((c) => {
  const m = missForState(c, race.state);
  const src = sourceById(m.scope === 'state' ? c.states_source : history.national_source);
  return { ...m, sourceLabel: src.publisher.split(' (')[0], sourceUrl: src.url };
});
const avgCandidates = candidates.map((c) => ({ id: c.id, name: c.sort_name, color: partyById(c.party).color, party: partyById(c.party).name }));
const pollLabels = Object.fromEntries(polls.map((p) => [p.id, `${p.pollster}, ${dateShort(pollDate(p))}`]));

const pollHeadline =
  polls.length === 0
    ? "We haven't added any polls for this race yet."
    : recent.length === 0
      ? `No polls in the last ${RECENT_DAYS} days. The ${plural(polls.length, 'poll')} below ${polls.length === 1 ? 'is' : 'are'} older.`
      : `${plural(recent.length, 'poll')} in the last ${RECENT_DAYS} days.`;

const sourceIds = [
  race.source,
  ...candidates.map((c) => c.source),
  ...ratings.map((r) => r.source),
  ...ratings.map((r) => r.found_via),
  ...polls.map((p) => p.source),
  ...past.map((p) => p.source),
  'fec-api',
];
const updated = [lastChecked(sourceIds), db.money.fetched_at.slice(0, 10)].sort().at(-1);
---
<Layout title={race.name} description={`${race.name}, ${office}: who's running, race ratings, polls, money, and past results. Every number sourced.`} updated={updated}>
  <nav class="crumbs small" aria-label="Breadcrumb">
    {race.chamber === 'senate' ? <a href="/senate/">Senate</a> : <a href="/house/">House</a>}
    {race.state === 'VA' && <> · <a href="/virginia/">Virginia</a></>} › {race.short}
  </nav>

  <header class="race-head">
    <div class="eyebrow">{office} · Election Day {date(race.election_date)}</div>
    <h1>{race.name}</h1>
    <Scoreboard s={summary} size="hero" link={false} />
    <p class="headline">{ratingsHeadline(ratings)}</p>
  </header>

  <div class="stack">
    <section class="card" aria-labelledby="ballot">
      <div class="eyebrow">The lineup</div>
      <h2 id="ballot"><Icon name="Users" />Who's on the ballot ({candidates.length})</h2>
      {race.note && <p class="small partisan-note">{race.note} {race.note_source && <Source id={race.note_source} />}</p>}
      <ul class="cands">
        {candidates.map((c) => (
          <li>
            <div>
              <a class="cname" href={`/candidates/${c.id}/`}>{c.ballot_name}</a>
              {c.incumbent && <span class="chip"><Term id="incumbent">Incumbent</Term></span>}
            </div>
            {c.note && <div class="small text-2">{c.note}</div>}
            <div class="row small">
              <PartyTag party={c.party} />
              {c.party_lines && c.party_lines.length > 1 && <span class="small muted">also on the {c.party_lines.slice(1).map((l) => partyById(l).name).join(', ')} line</span>}
              {c.website ? <a class="muted" href={c.website} target="_blank" rel="noopener nofollow">Campaign site ↗</a> : <span class="muted">No campaign website listed</span>}
            </div>
          </li>
        ))}
      </ul>
      {candidates.some((c) => sourceById(c.source).type !== 'official') && sourceById(race.source).type === 'official' && (
        <p class="small partisan-note">Not yet confirmed with {stateName(race.state)}'s official list: {candidates.filter((c) => sourceById(c.source).type !== 'official').map((c) => c.ballot_name).join(', ')} (from <Source id={candidates.find((c) => sourceById(c.source).type !== 'official')!.source} />).</p>
      )}
      {sourceById(race.source).type === 'official' ? (
        <p class="small muted">Listed alphabetically by last name. Your real ballot may use a different order. Names as certified by the state: <Source id={race.source} />.</p>
      ) : (
        <p class="small partisan-note">We haven't confirmed this list with {stateName(race.state)}'s election office yet. It comes from <Source id={race.source} />. Listed alphabetically by last name.</p>
      )}
    </section>

    <section class="card" aria-labelledby="ratings">
      <div class="eyebrow">Expert picks</div>
      <h2 id="ratings"><Icon name="Trophy" />What forecasters say</h2>
      {ratings.length > 0 ? <RatingScale ratings={ratings} /> : (
        <p class="text-2">{allRatingsHidden ? "We're double-checking these ratings against each forecaster's own site before publishing them." : 'No forecaster ratings loaded yet.'}</p>
      )}
      <Limits>
        A <Term id="race-rating">race rating</Term> is an expert's judgment, not a poll or a prediction of the final score. Forecasters update on their own schedules, so check the "as of" date.
      </Limits>
    </section>

    <section class="card" aria-labelledby="polls">
      <div class="row between">
        <div><div class="eyebrow">Game by game</div><h2 id="polls"><Icon name="ChartColumn" />Polls</h2></div>
        <ConfidenceBadge level={conf} recent={recent.length} total={polls.length} />
      </div>
      {baseAvg ? (
        <AverageBuilder client:visible today={todayIso} polls={avgPolls} candidates={avgCandidates}
          demId={pair.dem?.id ?? null} repId={pair.rep?.id ?? null} typicalMiss={history.typical_miss}
          misses={misses} stateName={stateName(race.state)} pollLabels={pollLabels} />
      ) : onHold.length ? (
        <div class="hold">
          <p class="headline">Average on hold</p>
          <p class="text-2">{plural(onHold.length, 'recent poll')} in this race {onHold.length === 1 ? 'is' : 'are'} still being checked against the original source. We don't publish an average until every recent poll is checked, because averaging only some of them could tilt the result. The checked polls are below.</p>
        </div>
      ) : (
        <p class="headline">{pollHeadline}{polls.length > 0 && recent.length === 0 && ' So there\u2019s no polling average right now.'}</p>
      )}
      {polls.length > 0 && <h3 class="every">Every poll ({polls.length})</h3>}
      <div class="stack">
        {polls.map((p) => <PollCard poll={p} candidates={candidates} today={today} />)}
      </div>
      <Limits>
        One poll is a snapshot, not a forecast. Each poll's range shows how far its lead could be off just from sampling. Real errors can be bigger. {conf !== 'lots' && 'With few recent polls, lean more on ratings, money, and past results.'}
      </Limits>
    </section>

    <section class="card" aria-labelledby="money">
      <div class="eyebrow">The budget</div>
      <h2 id="money"><Icon name="DollarSign" />Money raised</h2>
      <MoneyBars candidates={candidates} />
    </section>

    <section class="card" aria-labelledby="past">
      <div class="eyebrow">Last season's final</div>
      <h2 id="past"><Icon name="History" />Past results</h2>
      {race.redistricted ? (
        <p class="text-2">{race.redistricted} <Source id={race.redistricted_source!} /></p>
      ) : <PastResults race={race.id} />}
      {race.chamber === 'house' && !race.redistricted && (
        <Limits>These are results under the same district lines used in 2026. Past results don't decide future ones, especially with different candidates.</Limits>
      )}
    </section>

    <section class="card" aria-labelledby="positions">
      <div class="eyebrow">Game plan</div>
      <h2 id="positions"><Icon name="Flag" />Where they stand</h2>
      <p class="text-2">Coming soon: each candidate's top 3 policies in their own words, with a link to where they said it. We research every candidate in a race at the same time and publish them together.</p>
    </section>

    <SourceList ids={sourceIds} />
  </div>
</Layout>

<style>
  .crumbs { color: var(--muted); margin-bottom: 8px; }
  .race-head { margin-bottom: 16px; }
  .race-head :global(.board) { margin: 10px 0 12px; }
  .cands { list-style: none; padding: 0; margin: 0 0 8px; }
  .cands li { padding: 10px 0; border-bottom: 1px solid var(--border); }
  .cands li:last-child { border-bottom: 0; }
  .cname { font-weight: 700; margin-right: 6px; }
  .between { justify-content: space-between; }
  .every { margin: 20px 0 10px; font-size: 1rem; }
  .hold { border-left: 3px solid var(--warn-ink); padding-left: 12px; }
</style>
