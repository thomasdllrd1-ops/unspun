---
import Layout from '../../layouts/Layout.astro';
import SenateOverview, { type OverviewRace } from '../../islands/SenateOverview';
import Term from '../../components/Term.astro';
import Source from '../../components/Source.astro';
import Limits from '../../components/Limits.astro';
import { db, candidatesInRace, ratingsForRace, pollsForRace, resultsForPoll, majorPair, pendingRecentPolls, lastChecked } from '../../lib/data';
import { consensus, ratingColor, ratingLabel } from '../../lib/ratings';
import { pollingAverage, drMargin, missForState, type AvgPoll } from '../../lib/average';
import { pollDate } from '../../lib/polls';
import { stateName } from '../../lib/states';

const today = new Date().toISOString().slice(0, 10);
const short = (r: string) => ratingLabel(r as never).replace('Democratic', 'D').replace('Republican', 'R');
const senate = db.races.filter((r) => r.chamber === 'senate');
const races: OverviewRace[] = senate.map((race) => {
  const cands = candidatesInRace(race.id);
  const ratings = ratingsForRace(race.id);
  const cons = consensus(ratings);
  const { dem, rep } = majorPair(race.id);
  const ids = new Set(cands.map((c) => c.id));
  const polls: AvgPoll[] = pollsForRace(race.id).map((p) => ({
    id: p.id, pollster: p.pollster, sponsorType: p.sponsor_type, sponsorLean: p.sponsor_lean, population: p.population,
    sampleSize: p.sample_size, date: pollDate(p),
    shares: Object.fromEntries(resultsForPoll(p.id).filter((r) => ids.has(r.candidate)).map((r) => [r.candidate, r.pct])),
  }));
  const held = pendingRecentPolls(race.id, new Date(today)).length;
  const avg = held ? null : pollingAverage(polls, { today });
  const margin = avg ? drMargin(avg.shares, dem?.id ?? null, rep?.id ?? null) : null;
  return {
    state: race.state,
    stateName: stateName(race.state),
    raceId: race.id,
    special: race.id.endsWith('-special'),
    ratingFill: cons ? ratingColor(cons) : null,
    ratingText: cons ? `${ratingLabel(cons)}${new Set(ratings.map((r) => r.rating)).size > 1 ? ' (avg.)' : ''}` : 'Being checked',
    ratingShort: cons ? short(cons) : '…',
    margin,
    pollCount: avg?.used.length ?? 0,
    demName: dem?.sort_name ?? null,
    repName: rep?.sort_name ?? null,
    note: held ? `On hold: ${held} poll${held === 1 ? '' : 's'} being checked` : !dem || !rep ? (avg ? 'Not a Democrat-vs-Republican race' : null) : null,
    misses: db.pollHistory.cycles.map((c) => missForState(c, race.state)),
  };
});
const sourceIds = [...new Set(senate.flatMap((r) => ratingsForRace(r.id).map((x) => x.source))), db.pollHistory.national_source];
---
<Layout title="Senate" description="All 35 U.S. Senate races in 2026 on one equal-size map: forecaster ratings, our polling average, and what happens if the polls are wrong." updated={lastChecked([...sourceIds, 'wikipedia-senate-2026'])}>
  <div class="eyebrow">U.S. Senate · Nov 3, 2026</div>
  <h1>35 Senate seats are on the ballot</h1>
  <p class="headline">That's 33 regular races plus special elections in Florida and Ohio. Tap a state to see its race.</p>
  <SenateOverview client:visible races={races} typicalMiss={db.pollHistory.typical_miss} cycles={db.pollHistory.cycles.map((c) => c.cycle)} />
  <Limits>
    Forecaster colors average three experts' <Term id="race-rating">ratings</Term>. Poll colors use <a href="/show-our-work/#average">our published average</a>, only for races with polls in the last 60 days. The "what if" buttons use real past <Term id="polling-miss">polling misses</Term> (<Source id={db.pollHistory.national_source} label="AAPOR" />, state figures where available). Ratings and polls we haven't checked against the original source aren't shown.
  </Limits>
</Layout>
