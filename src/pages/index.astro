---
import Layout from '../layouts/Layout.astro';
import EagleMedallion from '../components/home/EagleMedallion.astro';
import StatStrip from '../components/home/StatStrip.astro';
import USMap from '../components/maps/USMap.astro';
import VirginiaMap from '../components/maps/VirginiaMap.astro';
import Scoreboard from '../components/Scoreboard.astro';
import CandidateCard from '../components/home/CandidateCard.astro';
import IssuePicker from '../components/home/IssuePicker.astro';
import PollReceipt from '../components/home/PollReceipt.astro';
import MidtermsChart from '../components/home/MidtermsChart.astro';
import { db, candidatesInRace, pollsForRace, moneyFor } from '../lib/data';
import { summarize } from '../lib/summary';
import { stateName } from '../lib/states';

const today = new Date();
const closest = db.races
  .map((r) => summarize(r, today))
  .filter((s) => s.status === 'close' || s.status === 'lead')
  .sort((a, b) => a.margin! - b.margin!)
  .slice(0, 4);
const FEATURED = 'va-sen';
const featured = candidatesInRace(FEATURED);
const maxRaised = Math.max(1, ...featured.map((c) => { const m = moneyFor(c.id); return m.status === 'ok' ? m.receipts ?? 0 : 0; }));
const receipts = pollsForRace(FEATURED).slice(0, 3);
const states = [...new Set(db.races.map((r) => r.state))].sort((a, b) => stateName(a).localeCompare(stateName(b)));
const researched = db.positions.map((p) => db.races.find((r) => r.id === p.race)!).filter(Boolean);
---
<Layout title="Unspun" wide>
  <section class="hero">
    <div class="hero-text">
      <h1>The 2026 midterms, minus the spin.</h1>
      <p class="lead">Every Senate race. Every Virginia district. The House toss-ups. Sources on everything.</p>
      <form class="go" data-go>
        <label for="state-pick">Where do you vote?</label>
        <div class="go-row">
          <select id="state-pick" name="state">
            <option value="">Pick your state</option>
            {states.map((s) => <option value={s.toLowerCase()} selected={s === 'VA'}>{stateName(s)}</option>)}
          </select>
          <button class="btn" type="submit">See my races</button>
        </div>
      </form>
      <p class="small"><a href="#virginia">In Virginia? Find your district by ZIP</a></p>
    </div>
    <div class="hero-art"><EagleMedallion /></div>
  </section>

  <StatStrip />

  <section id="map" class="sec">
    <h2>Find your race</h2>
    <USMap />
  </section>

  <section class="sec" aria-labelledby="close-h">
    <h2 id="close-h">Closest races right now</h2>
    <p class="text-2">Our average of checked polls, closest first. A score mid-game, not a result.</p>
    <div class="boards">{closest.map((s) => <Scoreboard s={s} />)}</div>
    <p class="small"><a href="/senate/">See every Senate race</a> · <a href="/house/">House toss-ups</a></p>
  </section>

  <section id="virginia" class="band navy on-navy">
    <div class="band-in">
      <h2>Virginia: find your district</h2>
      <p>One Senate seat and all 11 House seats are on your ballot.</p>
      <VirginiaMap />
    </div>
  </section>

  <section id="races" class="sec">
    <div class="sec-head">
      <h2>Head to head</h2>
      <p class="eyebrow">U.S. Senate · Virginia</p>
    </div>
    <div class="cards">{featured.map((c) => <CandidateCard c={c} maxRaised={maxRaised} />)}</div>
  </section>

  <section id="issues" class="sec">
    <h2>What do you care about?</h2>
    <p class="text-2">Pick an issue. Their own words, checked against their websites.</p>
    <IssuePicker raceId={FEATURED} />
    <form class="other" data-go-race>
      <label for="race-pick">Another race:</label>
      <select id="race-pick" name="race">
        {researched.map((r) => <option value={r.id}>{r.chamber === 'senate' ? `${stateName(r.state)} Senate${r.id.includes('special') ? ' (special)' : ''}` : r.short}</option>)}
      </select>
      <button class="btn btn-ghost" type="submit">Compare</button>
      <a href={`/races/${FEATURED}/quiz/`}>Blind quiz: who matches you?</a>
    </form>
  </section>

  <section id="polls" class="band paper">
    <div class="band-in">
      <h2>Poll receipts</h2>
      <p class="text-2">Who ran it, who paid for it, and which way they lean.</p>
      {receipts.length
        ? <div class="receipts">{receipts.map((p) => <PollReceipt poll={p} />)}</div>
        : <p>No checked polls in this race yet.</p>}
      <p class="small"><a href={`/races/${FEATURED}/#polls`}>Every Virginia Senate poll</a></p>
    </div>
  </section>

  <section id="history" class="sec">
    <div class="sec-head">
      <h2>Midterms past</h2>
      <img src="/images/bust.svg" alt="" class="bust" width="56" height="56" />
    </div>
    <MidtermsChart />
  </section>
</Layout>

<script>
  document.querySelector<HTMLFormElement>('[data-go]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = new FormData(e.currentTarget as HTMLFormElement).get('state');
    if (v) location.href = `/states/${v}/`;
  });
  document.querySelector<HTMLFormElement>('[data-go-race]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    location.href = `/races/${new FormData(e.currentTarget as HTMLFormElement).get('race')}/compare/`;
  });
</script>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 40px; padding: 48px 0 40px; }
  .hero-text { flex: 999 1 480px; min-width: 0; }
  .hero-art { flex: 1 1 280px; display: flex; justify-content: center; }
  h1 { font-size: clamp(3rem, 6.5vw, 5.5rem); line-height: 1; }
  .lead { margin: 20px 0 0; max-width: 30em; font-family: var(--font-serif); font-size: 1.25rem; color: var(--text-2); }
  .go { margin-top: 28px; }
  .go label { display: block; font-weight: 600; margin-bottom: 8px; }
  .go-row, .other { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  select { font: inherit; min-height: 48px; padding: 0 12px; border: 1.5px solid var(--navy); background: var(--paper-2); color: var(--ink); border-radius: 2px; }
  .sec { padding: 56px 0 8px; }
  .sec h2, .band h2 { font-size: clamp(2rem, 4vw, 2.9rem); }
  .sec-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; }
  .boards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); gap: 16px; margin: 16px 0 8px; }
  .band { margin: 56px calc(50% - 50vw) 0; padding: 56px 0; }
  .band-in { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .navy { background: var(--navy); color: var(--paper); --heading: var(--paper); --muted: #DCD3BD; --text-2: #DCD3BD; }
  .navy :global(a) { color: var(--gold-light); }
  .paper { background: var(--surface-2); border-block: 1px solid var(--border); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 20px; }
  .other { margin-top: 20px; }
  .receipts { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin: 20px 0 12px; }
  .bust { opacity: 0.9; background: var(--navy); border-radius: 28px 28px 0 0; padding: 6px 6px 0; }
  @media (max-width: 640px) { .band-in { padding: 0 16px; } .hero { padding-top: 28px; gap: 24px; } .hero-art :global(.medal) { width: 200px; } }
</style>
