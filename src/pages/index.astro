---
/**
 * The front door: find your race (map or ZIP), the numbers, and a tile for every section.
 * Each section lives on its own page; the toolbar gets you there from anywhere.
 */
import Layout from '../layouts/Layout.astro';
import StatStrip from '../components/home/StatStrip.astro';
import USMap from '../components/maps/USMap.astro';
import ZipFinder from '../components/home/ZipFinder.astro';
import SectionTiles from '../components/home/SectionTiles.astro';
---
<Layout title="Unspun" wide>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">2026 midterms · <span data-countdown="2026-11-03" data-unit="num">24</span> days to go</p>
      <h1>Find your race.</h1>
      <p class="lead">Tap your state, or type your ZIP. Then tap where you live.</p>
      <ZipFinder />
    </div>
    <div class="hero-map">
      <USMap picker={false} />
    </div>
  </section>

  <StatStrip />

  <section class="sec" aria-labelledby="explore-h">
    <h2 id="explore-h">Explore</h2>
    <SectionTiles />
  </section>
</Layout>

<style>
  .hero { display: grid; gap: 28px; align-items: center; padding: 14px 0 32px; }
  @media (min-width: 960px) { .hero { grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.6fr); gap: 40px; } }
  .hero-text { min-width: 0; }
  h1 { font-size: clamp(3rem, 6vw, 5rem); line-height: 1; margin: 6px 0 0; }
  .lead { margin: 14px 0 22px; max-width: 26em; font-family: var(--font-serif); font-size: 1.2rem; color: var(--text-2); }
  .hero-map { min-width: 0; }
  .sec { padding: 40px 0 8px; }
  .sec h2 { font-size: clamp(2rem, 4vw, 2.6rem); margin-bottom: 14px; }
  @media (max-width: 640px) { .hero { padding-top: 22px; } }
</style>
