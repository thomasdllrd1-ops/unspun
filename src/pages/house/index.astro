---
import Layout from '../../layouts/Layout.astro';
import Term from '../../components/Term.astro';
import Source from '../../components/Source.astro';
import Limits from '../../components/Limits.astro';
import { db, candidatesInRace, ratingsForRace, partyById, lastChecked } from '../../lib/data';
import { consensus, ratingColor, ratingLabel } from '../../lib/ratings';
import { money, date } from '../../lib/format';
import sel from '../../../data/house_selection.json';

const inData = new Set(db.races.map((r) => r.id));
const rows = sel.districts.map((d) => {
  const ratings = inData.has(d.race) ? ratingsForRace(d.race) : [];
  const cons = consensus(ratings);
  const race = db.races.find((r) => r.id === d.race);
  return { ...d, race, ratings, cons, cands: race ? candidatesInRace(race.id) : [] };
});
const heldR = rows.filter((r) => r.incumbent_party === 'republican').length;
const heldD = rows.filter((r) => r.incumbent_party === 'democratic').length;
---
<Layout title="House" description="The 19 U.S. House races that at least two of three forecasters rate a toss-up, and how we picked them." updated={lastChecked(['wikipedia-house-ratings-2026', 'fec-api'])}>
  <div class="eyebrow">U.S. House · Nov 3, 2026</div>
  <h1>19 House races rated toss-ups</h1>
  <p class="headline">All 435 House seats are on the ballot. We cover every district that at least 2 of 3 forecasters call a <Term id="toss-up">toss-up</Term>.</p>

  <div class="stack">
    <ul class="hlist">
      {rows.map((r) => (
        <li class="card">
          <a class="card-link" href={r.race ? `/races/${r.race.id}/` : undefined}>
            <div class="row between">
              <strong>{r.race?.name ?? r.race}</strong>
              {r.cons ? <span class="chip"><span class="dot" style={`background:${ratingColor(r.cons)}`}></span>{ratingLabel(r.cons)}</span> : <span class="chip muted">Ratings being checked</span>}
            </div>
            <div class="small text-2">
              {r.cands.length
                ? r.cands.map((c) => `${c.sort_name} (${partyById(c.party).abbr}${c.incumbent ? ', incumbent' : ''})`).join(' · ')
                : `Held by ${r.incumbent ?? 'a vacant seat'}; candidate list being confirmed`}
            </div>
            <div class="small muted">Raised by all candidates this cycle: {money(r.raised_all_candidates)}</div>
          </a>
        </li>
      ))}
    </ul>

    <section class="card">
      <h2>How we picked these</h2>
      <p class="text-2">{sel.rule} Ratings as of Cook {date(sel.ratings_as_of.cook)}, Inside Elections {date(sel.ratings_as_of.inside)}, Sabato {date(sel.ratings_as_of.sabato)} (found via <Source id={sel.ratings_found_via} label="Wikipedia's cited table" />).</p>
      <p class="text-2">{sel.history} Of the 19, {heldR} are held by Republicans and {heldD} by Democrats.</p>
      <p class="text-2">Order: {sel.order} {sel.not_used}</p>
    </section>

    <Limits>Toss-up ratings change. We picked this list on {date(sel.decided_on)} and will say so here if we add or remove a race. Every other House race is also on your ballot; look up yours at <a href="https://vote.gov" target="_blank" rel="noopener">vote.gov ↗</a>.</Limits>
  </div>
</Layout>
<style>
  .hlist { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .hlist .card { padding: 0; }
  .hlist .card-link { padding: 14px 16px; display: block; }
  .between { justify-content: space-between; margin-bottom: 4px; }
</style>
