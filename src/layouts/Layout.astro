---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/libre-caslon-display/400.css';
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/libre-caslon-text/400-italic.css';
import '@fontsource/libre-caslon-text/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import StripeBand from '../components/chrome/StripeBand.astro';
import Masthead from '../components/chrome/Masthead.astro';
import Dateline from '../components/chrome/Dateline.astro';
import Wordmark from '../components/chrome/Wordmark.astro';
import Icon from '../components/Icon.astro';
import { SHOW_PENDING } from '../lib/data';
import { date } from '../lib/format';

interface Props {
  title: string;
  description?: string;
  /** ISO date the facts on this page were last checked */
  updated?: string | null;
  /** Full-width page (the homepage); other pages use the narrow reading column. */
  wide?: boolean;
}
const { title, description = 'The 2026 midterms without the spin. Every number sourced.', updated, wide = false } = Astro.props;
const fullTitle = title === 'Unspun' ? 'Unspun · 2026 midterms, sourced' : `${title} · Unspun`;
const path = Astro.url.pathname;
const nav = [
  { href: '/senate/', label: 'Senate', icon: 'Map' },
  { href: '/house/', label: 'House', icon: 'Landmark' },
  { href: '/virginia/', label: 'Virginia', icon: 'MapPin' },
  { href: '/issues/', label: 'Issues', icon: 'Flag' },
  { href: '/how-to-vote/virginia/', label: 'Vote', icon: 'Vote' },
  { href: '/show-our-work/', label: 'Our work', icon: 'BookOpenCheck' },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1B2A47" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <!-- Apply the saved theme before the page paints (prevents a flash). -->
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <StripeBand />
    <Masthead nav={nav} path={path} />
    <Dateline />
    <div class="beta">
      <div class="wrap wide">
        <strong>Beta.</strong> Spot a mistake? <a href="/corrections/">Tell us</a>.
        {SHOW_PENDING && <span class="chip chip-pending">Preview mode: showing items still pending a check</span>}
      </div>
    </div>

    <main id="main" class:list={['wrap', { wide }]}>
      <slot />
      {updated && <p class="updated small muted">Facts on this page last checked {date(updated)}.</p>}
    </main>

    <nav class="tabbar" aria-label="Main (bottom)">
      {nav.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}><Icon name={n.icon} /><span>{n.label}</span></a>
      ))}
    </nav>

    <footer class="site-footer">
      <div class="wrap wide foot">
        <div class="foot-main">
          <Wordmark size={30} />
          <p>The 2026 midterms, minus the spin. No data is neutral, so we show all of it, label every source, and explain our choices.</p>
          <p class="small">An independent student project. Not affiliated with any campaign, party, or PAC.</p>
          <p class="credits">Maps: U.S. Census Bureau. Icons: game-icons.net, CC BY 3.0. Candidate photos: credited where shown. Code MIT; data CC BY-SA 4.0.</p>
        </div>
        <nav aria-label="Footer" class="foot-nav">
          <a href="/show-our-work/">Sources &amp; methods</a>
          <a href="/corrections/">Report an error</a>
          <a href="/corrections/#log">Corrections log</a>
          <a href="/glossary/">Glossary</a>
          <button type="button" class="print-btn" onclick="window.print()">Print this page</button>
        </nav>
      </div>
    </footer>
    <StripeBand />

    <script>
      // Keep day counts fresh on the visitor's device (the HTML was built earlier).
      // <x data-countdown="2026-10-23"> → "In 29 days" · <li data-date="2026-10-23"> gets .past once passed.
      const todayUtc = (() => { const n = new Date(); return Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()); })();
      const days = (iso: string) => Math.round((Date.parse(iso) - todayUtc) / 86_400_000);
      document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
        const n = days(el.dataset.countdown!);
        const u = el.dataset.unit;
        el.textContent = u === 'days' ? (n > 0 ? `${n} DAY${n === 1 ? '' : 'S'}` : n === 0 ? 'TODAY' : 'PASSED')
          : u === 'num' ? String(Math.max(0, n))
          : u === 'short' ? (n > 0 ? `${n}d` : n === 0 ? 'Today' : 'Passed')
          : n > 0 ? `In ${n} day${n === 1 ? '' : 's'}` : n === 0 ? 'Today' : 'Passed';
      });
      document.querySelectorAll<HTMLElement>('[data-date]').forEach((el) => {
        el.classList.toggle('past', days(el.dataset.date!) < 0);
      });

      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--navy); color: var(--paper); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }
  .beta { font-size: 0.82rem; color: var(--muted); padding: 6px 0; border-bottom: 1px solid var(--border); }
  .beta .chip { margin-left: 6px; }
  .updated { margin-top: 32px; }
  .tabbar { display: none; }
  @media (max-width: 640px) {
    .tabbar { display: grid; grid-template-columns: repeat(6, 1fr); position: fixed; left: 0; right: 0; bottom: 0; z-index: 6; background: var(--navy); border-top: 3px solid var(--gold); padding: 4px 4px calc(4px + env(safe-area-inset-bottom)); }
    .tabbar a { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 2px; min-height: 48px; color: var(--paper); text-decoration: none; font-weight: 600; font-size: 0.72rem; }
    .tabbar a :global(.icon) { width: 22px; height: 22px; }
    .tabbar a[aria-current='page'] { color: var(--gold-light); }
    :global(body) { padding-bottom: 64px; }
  }
  .site-footer { background: var(--navy); color: #DCD3BD; border-top: 4px solid var(--gold); margin-top: 32px; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px 40px; padding-top: 36px; padding-bottom: 36px; font-size: 0.9rem; }
  .foot-main { max-width: 34em; color: var(--paper); }
  .foot-main p { margin: 10px 0 0; color: #DCD3BD; }
  .credits { font-family: var(--font-mono); font-size: 0.75rem; }
  .foot-nav { display: flex; flex-wrap: wrap; gap: 0 28px; align-content: flex-start; }
  .foot-nav a, .print-btn { color: var(--paper); padding: 10px 0; min-height: 44px; display: inline-flex; align-items: center; }
  .print-btn { background: none; border: 0; font: inherit; text-decoration: underline; cursor: pointer; }
</style>
