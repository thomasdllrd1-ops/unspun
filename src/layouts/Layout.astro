---
import '../styles/global.css';
import { SHOW_PENDING } from '../lib/data';
import { date } from '../lib/format';

interface Props {
  title: string;
  description?: string;
  /** ISO date the facts on this page were last checked */
  updated?: string | null;
}
const { title, description = 'The 2026 midterms without the spin. Every number sourced.', updated } = Astro.props;
const fullTitle = title === 'Unspun' ? 'Unspun · 2026 midterms, sourced' : `${title} · Unspun`;
const path = Astro.url.pathname;
const nav = [
  { href: '/virginia/', label: 'Virginia' },
  { href: '/how-to-vote/virginia/', label: 'How to vote' },
  { href: '/show-our-work/', label: 'Our work' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1113" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <!-- Apply the saved theme before the page paints (prevents a flash). -->
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label="Unspun home">unspun<span aria-hidden="true">.</span></a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch light or dark theme" title="Switch theme">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.5 0-.9-.1-1.4A5.5 5.5 0 0 1 13.4 3.1 9 9 0 0 0 12 3Z"/></svg>
        </button>
      </div>
      <div class="beta">
        <div class="wrap">
          <strong>Beta.</strong> We're adding races every few days. Spot a mistake? <a href="/corrections/">Tell us</a>.
          {SHOW_PENDING && <span class="chip chip-pending">Preview mode: showing items still pending a check</span>}
        </div>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
      {updated && <p class="updated small muted">Facts on this page last checked {date(updated)}.</p>}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p><strong>unspun</strong>: the 2026 midterms for people who've never read a poll. No data is neutral, so we show all of it, label every source, and explain our choices.</p>
        <p class="row small">
          <a href="/show-our-work/">How we work</a>
          <a href="/corrections/">Report an error</a>
          <a href="/corrections/#log">Corrections log</a>
          <a href="/glossary/">Glossary</a>
        </p>
        <p class="small muted">Not affiliated with any campaign, party, or PAC. Code is MIT-licensed; our data is CC BY-SA 4.0.</p>
      </div>
    </footer>

    <script>
      // Keep day counts fresh on the visitor's device (the HTML was built earlier).
      // <x data-countdown="2026-10-23"> → "In 29 days" · <li data-date="2026-10-23"> gets .past once passed.
      const todayUtc = (() => { const n = new Date(); return Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()); })();
      const days = (iso: string) => Math.round((Date.parse(iso) - todayUtc) / 86_400_000);
      document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
        const n = days(el.dataset.countdown!);
        const unit = el.dataset.unit === 'short' ? 'd' : n === 1 ? ' day' : ' days';
        el.textContent = n > 0 ? (el.dataset.unit === 'short' ? `${n}${unit}` : `In ${n}${unit}`) : n === 0 ? 'Today' : 'Passed';
      });
      document.querySelectorAll<HTMLElement>('[data-date]').forEach((el) => {
        el.classList.toggle('past', days(el.dataset.date!) < 0);
      });

      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const next = current === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--text); color: var(--bg); padding: 8px 12px; border-radius: 8px; z-index: 10; }
  .skip:focus { left: 8px; }
  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in oklab, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; gap: 12px; min-height: 56px; }
  .logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; text-decoration: none; }
  .logo span { color: var(--muted); }
  nav { display: flex; gap: 2px; margin-left: auto; overflow-x: auto; min-width: 0; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  nav a { text-decoration: none; font-size: 0.9rem; font-weight: 600; color: var(--text-2); padding: 10px 8px; white-space: nowrap; }
  nav a[aria-current='page'] { color: var(--text); text-decoration: underline; text-underline-offset: 6px; }
  .theme-toggle { background: none; border: 1px solid var(--border); color: var(--text); border-radius: 999px; width: 40px; height: 40px; display: grid; place-items: center; cursor: pointer; flex: none; }
  .beta { font-size: 0.8rem; color: var(--text-2); border-top: 1px solid var(--border); padding: 6px 0; }
  .beta .chip { margin-left: 6px; }
  .updated { margin-top: 32px; }
  .site-footer { border-top: 1px solid var(--border); padding: 24px 0 40px; color: var(--text-2); font-size: 0.9rem; }
  .site-footer .row { gap: 16px; }
  @media (max-width: 420px) { .logo { font-size: 1.1rem; } nav a { padding: 10px 6px; font-size: 0.85rem; } }
</style>
