---
/** Unspun logo: a star inside a ballot checkbox, plus the wordmark. Drawn in code. */
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<span class="logo-wrap">
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect x="1.5" y="1.5" width="29" height="29" rx="6" fill="none" stroke="currentColor" stroke-width="3" />
    <path d="M16 6.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z" fill="var(--accent)" />
  </svg>
  <span class="logo-word">UNSPUN</span>
</span>
<style>
  .logo-wrap { display: inline-flex; align-items: center; gap: 8px; }
  .logo-mark { flex: none; }
  .logo-word { font-family: var(--font-display); font-weight: 800; font-style: italic; font-size: 1.45rem; letter-spacing: 0.04em; line-height: 1; }
</style>
