---
/**
 * One poll, same layout for every poll:
 *   layer 1: who's ahead and by how much, with the margin-of-error range
 *   layer 2: bars for each answer
 *   layer 3 (tap to expand): every tag (sponsor, voters, method, size, dates) + notes
 */
import type { Poll, Candidate } from '../lib/schema';
import { resultsForPoll, partyById, db, sourceById } from '../lib/data';
import { leadRange, pollDate, daysBetween, RECENT_DAYS } from '../lib/polls';
import { dateRange, date, pct, plural } from '../lib/format';
import Term from './Term.astro';
import Source from './Source.astro';
import Pending from './Pending.astro';

interface Props { poll: Poll; candidates: Candidate[]; today: Date }
const { poll, candidates, today } = Astro.props;
const byId = new Map(candidates.map((c) => [c.id, c]));

const results = resultsForPoll(poll.id)
  .map((r) => {
    const c = r.candidate ? byId.get(r.candidate) : undefined;
    return { ...r, name: c ? c.sort_name : r.label, party: c ? partyById(c.party) : null };
  })
  .sort((a, b) => b.pct - a.pct);

// Lead between the two candidates on the ballot with the highest shares.
const onBallot = results.filter((r) => r.party);
const [a, b] = onBallot;
const range = a && b ? leadRange(a.pct, b.pct, poll.sample_size, poll.moe) : null;
const age = daysBetween(pollDate(poll), today);
/** "Taylor +7.3" or "Wittman +9.3" or "a tie": never a bare negative number. */
const side = (v: number) => (Math.abs(v) < 0.05 ? 'a tie' : v > 0 ? `${a.name} +${v.toFixed(1)}` : `${b.name} +${Math.abs(v).toFixed(1)}`);
const old = age > RECENT_DAYS;

const sponsorText: Record<Poll['sponsor_type'], string> = {
  independent: 'Independent',
  media: 'Media',
  academic: 'University',
  campaign: 'Campaign poll',
  party: 'Party poll',
  'partisan-aligned': 'Partisan-aligned sponsor',
  'not-stated': 'Sponsor not stated',
  unknown: "Sponsor's leaning not verified",
};
const pop = { LV: ['likely-voters', 'Likely voters'], RV: ['registered-voters', 'Registered voters'], A: ['adults', 'Adults'], unknown: ['sample-size', 'Voter group not stated'] } as const;
const methodText: Record<Poll['method'], string> = { phone: 'Phone', online: 'Online', text: 'Text', ivr: 'Automated phone', mixed: 'Mixed methods', unknown: 'Method not stated' };

// Track record (FiveThirtyEight grade, frozen Sep 2024)
const grade = db.pollsterRatings.ratings[poll.pollster] ?? null;
const pollsterInfo = db.pollsters.find((x) => x.name === poll.pollster);

// Plain-English summary for the decoder
const partisan = ['campaign', 'party', 'partisan-aligned'].includes(poll.sponsor_type);
const leanWord = { D: 'Democratic', R: 'Republican', none: '', unknown: '' }[poll.sponsor_lean];
const who =
  poll.population === 'unknown'
    ? poll.sample_size ? `${poll.sample_size.toLocaleString('en-US')} voters (which kind isn't stated)` : "voters (how many, and which kind, isn't stated)"
    : poll.sample_size ? `${poll.sample_size.toLocaleString('en-US')} ${pop[poll.population][1].toLowerCase()}` : `${pop[poll.population][1].toLowerCase()} (how many isn't stated)`;
const paidBy = poll.sponsor && poll.sponsor !== poll.pollster ? `, paid for by ${poll.sponsor}${leanWord ? ` (a ${leanWord}-aligned sponsor)` : ''}` : '';
const summary = `${poll.pollster} asked ${who}${paidBy}.` +
  (a && b
    ? range
      ? range.tossup
        ? ` ${a.name} led by ${(a.pct - b.pct).toFixed(1)}, which is within the poll's margin of error, so it's a statistical tie.`
        : ` ${a.name} led by ${(a.pct - b.pct).toFixed(1)}, more than the poll's margin of error.`
      : ` ${a.name} led by ${(a.pct - b.pct).toFixed(1)}. Without a margin of error, we can't say whether that's a real lead.`
    : '');

// Range bar geometry: ±40 points centered on a tie.
const SPAN = 40;
const x = (v: number) => 50 + (Math.max(-SPAN, Math.min(SPAN, v)) / SPAN) * 50;
---
<article class="poll card">
  <div class="top">
    <div>
      <div class="eyebrow">{poll.pollster}{poll.sponsor && poll.sponsor !== poll.pollster ? ` for ${poll.sponsor}` : ''}</div>
      <div class="when small">
        {poll.field_start ? dateRange(poll.field_start, poll.field_end) : poll.released ? `Released ${date(poll.released)}` : 'Dates not stated'}
        {old && <span class="chip">Older than {RECENT_DAYS} days</span>}
        {poll.status === 'pending' && <Pending />}
      </div>
    </div>
  </div>

  {range && a && b && (
    <>
      <p class="lead">
        <strong>{range.lead === 0 ? 'Tied' : `${a.name} +${range.lead.toFixed(1)}`}</strong>
        {range.tossup && <span class="chip">Statistical toss-up</span>}
      </p>
      <p class="small text-2 rangetext"><Term id="moe-lead">Range</Term>: {side(range.low)} to {side(range.high)}</p>
    </>
  )}
  {!range && a && b && (
    <>
      <p class="lead"><strong>{a.pct === b.pct ? 'Tied' : `${a.name} +${(a.pct - b.pct).toFixed(1)}`}</strong></p>
      <p class="text-2 small">No sample size or <Term id="margin-of-error">margin of error</Term> was published, so we can't show a range.</p>
    </>
  )}
  {range && (
    <svg class="range" viewBox="0 0 100 18" preserveAspectRatio="none" role="img"
      aria-label={`The real margin could be anywhere from ${side(range.low)} to ${side(range.high)}.`}>
      <rect x="0" width="100" y="7" height="4" rx="2" class="track" />
      <line x1="50" x2="50" y1="0" y2="18" class="zero" />
      <rect x={x(range.low)} width={Math.max(0.5, x(range.high) - x(range.low))} y="5" height="8" rx="2" class="band" />
      <line x1={x(range.lead)} x2={x(range.lead)} y1="2" y2="16" class="point" />
    </svg>
  )}
  {range && (
    <div class="range-axis small muted" aria-hidden="true"><span>← {b!.name} ahead</span><span>tie</span><span>{a!.name} ahead →</span></div>
  )}

  <ul class="answers">
    {results.map((r) => (
      <li>
        <span class="name">{r.name}</span>
        <span class="bar-track" aria-hidden="true"><span class={`bar ${r.party?.color ?? 'neutral'}`} style={`width:${r.pct}%`}></span></span>
        <span class="num val">{pct(r.pct)}</span>
      </li>
    ))}
  </ul>

  <div class="tags row">
    <span class="chip">{sponsorText[poll.sponsor_type]}</span>
    <span class="chip"><Term id={pop[poll.population][0]}>{pop[poll.population][1]}</Term></span>
    <span class="chip">{methodText[poll.method]}</span>
    {poll.sample_size && <span class="chip"><Term id="sample-size">{poll.sample_size.toLocaleString('en-US')} people</Term></span>}
    {poll.moe && <span class="chip"><Term id="margin-of-error">±{poll.moe}</Term></span>}
  </div>

  <details class="more">
    <summary>Poll decoder: what this poll can and can't tell you</summary>
    <p class="plain small"><strong>In plain English:</strong> {summary}</p>
    {partisan && (
      <p class="small partisan-note">Polls paid for by a campaign, party, or partisan group can be accurate, but the sponsor chooses whether to release them. We label these the same way for every party.</p>
    )}
    <dl class="decoder small">
      <dt>Who ran it</dt><dd>{poll.pollster}.</dd>
      <dt>Track record</dt><dd>{grade
        ? grade.grade != null
          ? <><Term id="pollster-grade">FiveThirtyEight grade</Term>: <strong>{grade.grade.toFixed(1)} out of 3</strong>, based on {grade.polls_analyzed.toLocaleString('en-US')} past poll{grade.polls_analyzed === 1 ? '' : 's'}{grade.polls_analyzed < 5 ? ' (very few, so treat this grade with caution)' : ''}. Last updated Sep 2024. <Source id={db.pollsterRatings.source} label="data" /></>
          : 'FiveThirtyEight lists this pollster as inactive, with no current grade.'
        : pollsterInfo?.track_record_note || 'Not yet researched.'}</dd>
      <dt>Who paid</dt><dd>{poll.sponsor || 'Not stated in the release.'}{poll.sponsor_type === 'unknown' ? " We haven't verified whether this sponsor leans toward a party." : ''}</dd>
      <dt>Who they asked</dt><dd>{pop[poll.population][1]}{poll.sample_size ? `, ${plural(poll.sample_size, 'person', 'people')}` : ''}.</dd>
      <dt>How</dt><dd>{poll.method_detail || methodText[poll.method]}</dd>
      <dt>When</dt><dd>{poll.field_start ? dateRange(poll.field_start, poll.field_end) : 'Field dates not stated'}{poll.released ? `; released ${date(poll.released)}` : ''}.</dd>
      {poll.notes && (<><dt>Notes</dt><dd>{poll.notes}</dd></>)}
    </dl>
    <Source id={poll.source} label={{ pollster: "Read the pollster's release", news: 'Read the news report' }[sourceById(poll.source).type as string] ?? 'See the source'} />
  </details>
</article>

<style>
  .poll { padding: 14px 16px; }
  .when { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; color: var(--text-2); }
  .rangetext { margin: 0; }
  .lead { margin: 10px 0 4px; font-size: 1.05rem; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .range { width: 100%; height: 18px; display: block; margin-top: 6px; }
  .range .track { fill: var(--grid); }
  .range-axis { display: flex; justify-content: space-between; font-size: 0.72rem; margin: 2px 0 10px; }
  .range .zero { stroke: var(--muted); stroke-width: 0.4; stroke-dasharray: 1 1; vector-effect: non-scaling-stroke; }
  .range .band { fill: var(--text); opacity: 0.25; }
  .range .point { stroke: var(--text); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .answers { list-style: none; padding: 0; margin: 8px 0 12px; }
  .answers li { display: grid; grid-template-columns: minmax(80px, 34%) 1fr 52px; gap: 8px; align-items: center; font-size: 0.9rem; padding: 3px 0; }
  .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar-track { height: 10px; }
  .bar { display: block; height: 100%; border-radius: 0 3px 3px 0; }
  .bar.dem { background: var(--dem); } .bar.rep { background: var(--rep); } .bar.other { background: var(--other); } .bar.neutral { background: var(--neutral); }
  .val { text-align: right; font-weight: 600; }
  .tags { gap: 6px; }
  .plain { margin: 10px 0 8px; }
  .partisan-note { border-left: 3px solid var(--warn-ink); padding: 2px 0 2px 10px; color: var(--text-2); margin-bottom: 8px; }
  .decoder { display: grid; grid-template-columns: 110px 1fr; gap: 6px 12px; margin: 8px 0 12px; }
  .decoder dt { color: var(--muted); font-weight: 600; }
  .decoder dd { margin: 0; }
  @media (max-width: 420px) { .decoder { grid-template-columns: 1fr; } .decoder dd { margin-bottom: 6px; } }
</style>
