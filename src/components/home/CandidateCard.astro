---
/**
 * One candidate (DESIGN.md #8): gilt oval portrait, role, name, party, top 3 priorities in their
 * own words, money raised. Same card for every candidate in a race, never just two.
 * Portraits all get the same engraving filter; initials when we have no photo.
 */
import photos from '../../../data/photos.json';
import type { Candidate } from '../../lib/schema';
import { partyById, moneyFor, raceResearch, positionsOf } from '../../lib/data';
import { money, date } from '../../lib/format';

interface Props { c: Candidate; maxRaised: number }
const { c, maxRaised } = Astro.props;
const party = partyById(c.party);
const photo = (photos.photos as Record<string, { file: string; credit: string }>)[c.id];
const initials = c.ballot_name.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).slice(0, 2).join('');
const research = raceResearch(c.race);
const cp = research.shown ? positionsOf(research, c.id) : null;
const m = moneyFor(c.id);
const raised = m.status === 'ok' ? m.receipts ?? 0 : null;
---
<article class="cand">
  <div class="top">
    <div class="oval">
      {photo ? <img src={photo.file} alt={`${c.ballot_name}`} loading="lazy" /> : <span class="init" aria-hidden="true">{initials}</span>}
    </div>
    <div class="id">
      <p class="role">{c.incumbent ? 'Incumbent' : 'Challenger'}</p>
      <h3><a href={`/candidates/${c.id}/`}>{c.ballot_name}</a></h3>
      <span class={`pchip ${party.color}`}>{party.name}</span>
    </div>
  </div>
  <div>
    <h4>Priorities, in their words</h4>
    {cp ? (cp.priorities.length
      ? <ol class="pri">{cp.priorities.map((p) => <li><a href={`/candidates/${c.id}/`}>{p.heading || `${p.quote.split(' ').slice(0, 10).join(' ')}…`}</a></li>)}</ol>
      : <p class="small muted">{cp.priorities_note}</p>)
      : <p class="small muted">Not yet researched.</p>}
  </div>
  <div>
    <h4>Money raised</h4>
    {raised !== null ? (
      <>
        <div class="bar" aria-hidden="true"><span class={party.color} style={`width:${Math.max(1, (raised / Math.max(1, maxRaised)) * 100).toFixed(1)}%`}></span></div>
        <p class="amt"><strong>{money(raised)}</strong> <span class="muted">through {date((m as { coverage_end: string }).coverage_end)} · <a href={(m as { fec_url: string }).fec_url}>FEC</a></span></p>
      </>
    ) : <p class="small muted">No FEC reports.</p>}
    <slot />
  </div>
  {photo && <p class="credit">{photo.credit}</p>}
</article>
<style>
  .cand { background: var(--surface); border: 1px solid var(--border); padding: 24px; display: flex; flex-direction: column; gap: 18px; }
  .top { display: flex; gap: 20px; align-items: center; }
  .oval { flex: none; width: 120px; height: 150px; border-radius: 50%; padding: 6px; background: var(--gold); box-shadow: inset 0 0 0 2px var(--gold-dark); }
  .oval img, .init { width: 100%; height: 100%; border-radius: 50%; display: block; }
  .oval img { object-fit: cover; object-position: 50% 25%; filter: grayscale(1) sepia(0.45) contrast(1.08) brightness(1.02); }
  .init { display: grid; place-items: center; background: #E6DCC2; color: var(--navy); font-family: var(--font-display); font-size: 2.4rem; }
  .role { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  h3 { margin: 4px 0 8px; font-size: 1.5rem; }
  h3 a { color: var(--heading); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .pchip { display: inline-block; padding: 3px 10px; font-size: 0.8rem; font-weight: 600; color: var(--party-ink, #fff); }
  .pchip.dem { background: var(--dem); } .pchip.rep { background: var(--rep); } .pchip.other { background: var(--other); }
  :global(:root[data-theme='dark']) .pchip { --party-ink: var(--navy); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .pchip { --party-ink: var(--navy); } }
  h4 { margin: 0 0 8px; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--eyebrow); font-family: var(--font); }
  .pri { margin: 0; padding-left: 22px; font-family: var(--font-serif); font-size: 1.05rem; }
  .pri li { margin: 4px 0; }
  .pri a { color: inherit; }
  .bar { height: 12px; border: 1px solid var(--border-strong); }
  .bar span { display: block; height: 100%; }
  .bar .dem { background: var(--dem); } .bar .rep { background: var(--rep); } .bar .other { background: var(--other); }
  .amt { margin: 6px 0 0; font-family: var(--font-mono); font-size: 0.85rem; }
  .credit { margin: 0; font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
</style>
