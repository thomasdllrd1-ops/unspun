---
/** Navy disc, gold rings, 13 stars, heraldic eagle (DESIGN.md #4). An original emblem, not the Presidential Seal. */
const stars = Array.from({ length: 13 }, (_, i) => (i * 360) / 13);
---
<div class="medal">
  <svg viewBox="0 0 320 320" aria-hidden="true">
    <circle cx="160" cy="160" r="156" fill="#1B2A47" />
    <circle cx="160" cy="160" r="146" fill="none" stroke="#D4B26A" stroke-width="2" />
    <circle cx="160" cy="160" r="112" fill="none" stroke="#D4B26A" stroke-width="1" />
    <g fill="#D4B26A">
      {stars.map((a) => <path transform={`rotate(${a.toFixed(1)} 160 160) translate(160 30)`} d="M0-7l1.6 4.9H7L2.7 1l1.6 5L0 3 -4.3 6l1.6-5L-7-2.1h5.4z" />)}
    </g>
  </svg>
  <img src="/images/eagle-gold.svg" alt="Unspun emblem: a heraldic eagle in a ring of thirteen stars" />
</div>
<style>
  .medal { position: relative; width: 320px; max-width: 100%; aspect-ratio: 1; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  img { position: absolute; left: 22%; top: 22%; width: 56%; height: 56%; }
</style>
