---
/**
 * Home page banner: a night-game scoreboard with the Capitol dome and stars,
 * drawn in code (no image files). The countdown uses split-flap style tiles.
 */
import { daysUntil } from '../lib/format';
interface Props { election: string }
const { election } = Astro.props;
const days = Math.max(0, daysUntil(election));
const digits = String(days).padStart(2, '0').split('');
// Star field: fixed positions so every build looks the same.
const stars = [[40, 30, 1.6], [92, 64, 1.1], [150, 22, 1.4], [210, 50, 1], [268, 18, 1.8], [330, 58, 1.2], [372, 26, 1], [420, 70, 1.5], [470, 34, 1.1], [520, 16, 1.3], [566, 62, 1], [610, 28, 1.7], [660, 52, 1.2], [705, 20, 1], [742, 66, 1.4], [30, 92, 1], [120, 104, 1.3], [560, 100, 1.1], [690, 96, 1.5]];
---
<section class="hero" aria-labelledby="hero-title">
  <svg class="hero-art" viewBox="0 0 760 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
      <radialGradient id="glow" cx="50%" cy="100%" r="75%">
        <stop offset="0%" stop-color="#ffc83d" stop-opacity="0.22" />
        <stop offset="60%" stop-color="#ffc83d" stop-opacity="0.04" />
        <stop offset="100%" stop-color="#ffc83d" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="760" height="300" fill="url(#glow)" />
    {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#fff" opacity="0.55" />)}
    <!-- Capitol dome silhouette -->
    <g fill="#1d232c" stroke="#2c343f" stroke-width="1">
      <rect x="120" y="258" width="520" height="42" />
      <rect x="160" y="238" width="440" height="22" />
      <rect x="300" y="214" width="160" height="26" />
      <path d="M318 214 V176 H442 V214 Z" />
      <path d="M322 176 Q380 88 438 176 Z" />
      <rect x="370" y="104" width="20" height="30" />
      <path d="M366 104 Q380 84 394 104 Z" />
      <rect x="378" y="74" width="4" height="14" />
    </g>
    <g stroke="#2c343f" stroke-width="2">
      {[330, 344, 358, 372, 388, 402, 416, 430].map((x) => <line x1={x} y1="180" x2={x} y2="212" />)}
      {[180, 205, 230, 255, 280, 480, 505, 530, 555, 580].map((x) => <line x1={x} y1="242" x2={x} y2="258" />)}
    </g>
    <circle cx="380" cy="72" r="3" fill="#ffc83d" />
  </svg>

  <div class="hero-inner">
    <div class="eyebrow hero-eyebrow">Game day · Tuesday, Nov 3, 2026</div>
    <div class="flap" aria-hidden="true" data-flap={election}>
      {digits.map((d) => <span class="tile">{d}</span>)}
      <span class="flap-unit">days<br />to go</span>
    </div>
    <h1 id="hero-title"><span class="visually-hidden"><span data-countdown={election} data-unit="num">{days}</span> days to go. </span>The midterms, explained like a scoreboard.</h1>
    <p class="hero-sub">Who's ahead in the polls, how sure we can be, and what the experts pick, all in terms you already know from sports. Every number is sourced.</p>
    <div class="hero-cta">
      <a class="btn" href="/senate/">See the Senate board</a>
      <a class="btn btn-ghost-dark" href="/how-to-vote/virginia/">How to vote</a>
    </div>
  </div>
</section>

<script>
  // Keep the flap tiles current on the visitor's device (the page was built earlier).
  document.querySelectorAll<HTMLElement>('[data-flap]').forEach((el) => {
    const n = new Date(); const today = Date.UTC(n.getFullYear(), n.getMonth(), n.getDate());
    const days = Math.max(0, Math.round((Date.parse(el.dataset.flap!) - today) / 86_400_000));
    const tiles = el.querySelectorAll('.tile');
    const digits = String(days).padStart(tiles.length, '0').slice(-tiles.length);
    tiles.forEach((t, i) => (t.textContent = digits[i]));
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; background: var(--board); color: var(--board-ink); border-radius: var(--radius); margin: 4px 0 20px; border: 1px solid rgba(255,255,255,.08); }
  .hero-art { position: absolute; inset: auto 0 0 0; width: 100%; height: 100%; }
  .hero-inner { position: relative; padding: 22px 20px 26px; }
  .hero-eyebrow { color: var(--accent); }
  .flap { display: flex; align-items: flex-end; gap: 6px; margin: 10px 0 14px; }
  .tile { position: relative; font-family: var(--font-display); font-weight: 800; font-size: clamp(3.4rem, 16vw, 5rem); line-height: 1; color: #fff; background: linear-gradient(#1f252e 50%, #171c23 50%); padding: 8px 12px 6px; border-radius: 8px; border: 1px solid rgba(255,255,255,.1); box-shadow: 0 6px 18px rgba(0,0,0,.4); font-variant-numeric: tabular-nums; }
  .tile::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: rgba(0,0,0,.55); }
  .flap-unit { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.05; color: var(--accent); margin-left: 6px; padding-bottom: 8px; font-size: 1.1rem; }
  h1 { color: #fff; font-size: clamp(1.9rem, 7.5vw, 2.8rem); max-width: 16ch; margin-bottom: 10px; }
  .hero-sub { color: #c3c8cf; max-width: 46ch; font-size: 1.02rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .btn-ghost-dark { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.35); }
</style>
